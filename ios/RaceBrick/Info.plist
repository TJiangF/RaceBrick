<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key><string>RaceBrick</string>
    <key>CFBundleName</key><string>RaceBrick</string>
    <key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleShortVersionString</key><string>0.1.0</string>
    <key>CFBundleVersion</key><string>1</string>
    <key>LSRequiresIPhoneOS</key><true/>
    <key>UILaunchScreen</key><dict/>
    <key>NSBluetoothAlwaysUsageDescription</key>
    <string>RaceBrick 需要蓝牙连接设备，发送地图帧和媒体状态。</string>
    <key>NSBluetoothPeripheralUsageDescription</key>
    <string>RaceBrick 需要蓝牙连接设备。</string>
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>RaceBrick 需要定位来生成导航地图帧。</string>
    <key>NSLocalNetworkUsageDescription</key>
    <string>RaceBrick 需要访问局域网中的 RaceBrick 设备。</string>
    <key>UIBackgroundModes</key>
    <array><string>bluetooth-central</string><string>location</string><string>audio</string></array>
    <key>UISupportedInterfaceOrientations</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
    <key>UISupportedInterfaceOrientations~ipad</key>
    <array>
        <string>UIInterfaceOrientationPortrait</string>
        <string>UIInterfaceOrientationPortraitUpsideDown</string>
        <string>UIInterfaceOrientationLandscapeLeft</string>
        <string>UIInterfaceOrientationLandscapeRight</string>
    </array>
</dict>
</plist>
