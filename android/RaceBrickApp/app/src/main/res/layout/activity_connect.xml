<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090C"
    android:fitsSystemWindows="true"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:lineSpacingExtra="0dp"
        android:text="RACE&#10;BRICK"
        android:textColor="#66E0D2"
        android:textSize="42sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.25"
        android:text="设备连接"
        android:textColor="#6D817D"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvConnectStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:text="未连接 RaceBrick"
        android:textColor="#A9C4BE"
        android:textSize="14sp" />

    <Button
        android:id="@+id/btnConnectDevice"
        android:layout_width="240dp"
        android:layout_height="52dp"
        android:layout_marginTop="18dp"
        android:background="@drawable/btn_primary"
        android:backgroundTint="@null"
        android:text="连接 RaceBrick"
        android:textColor="#F2FFFB"
        android:textSize="16sp" />

    <Button
        android:id="@+id/btnSkipConnect"
        android:layout_width="240dp"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_secondary"
        android:backgroundTint="@null"
        android:text="跳过，先使用本地数据"
        android:textColor="#A9C4BE"
        android:textSize="13sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:text="连接后可进行导航投屏、WiFi 配置和媒体控制"
        android:textColor="#6D817D"
        android:textSize="12sp" />
</LinearLayout>
