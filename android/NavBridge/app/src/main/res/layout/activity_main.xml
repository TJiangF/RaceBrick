<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#06090C">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#06090C"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:paddingTop="28dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:lineSpacingExtra="0dp"
                android:text="RACE&#10;BRICK"
                android:textColor="#66E0D2"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:letterSpacing="0.18"
                android:text="PHONE LINK"
                android:textColor="#6D817D"
                android:textSize="10sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRace"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="40dp"
                    android:text="RACE"
                    android:textColor="#F2B95C" />

                <Button
                    android:id="@+id/btnOffline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="40dp"
                    android:text="本地"
                    android:textColor="#A78BFA" />

                <Button
                    android:id="@+id/btnWifi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="40dp"
                    android:text="WiFi"
                    android:textColor="#66E0D2" />

                <Button
                    android:id="@+id/btnSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:minHeight="40dp"
                    android:text="设置"
                    android:textColor="#D7E7E4" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="已连接设备"
                android:textColor="#A9C4BE"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical"
                android:padding="12dp">

                <EditText
                    android:id="@+id/etKeyword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:hint="输入目的地，例如：天安门"
                    android:inputType="text"
                    android:padding="12dp"
                    android:textColor="#F0F6F4"
                    android:textColorHint="#6D817D"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/llTips"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tvDest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="尚未选择目的地"
                    android:textColor="#66D9A6"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/btn_secondary"
                        android:backgroundTint="@null"
                        android:text="开始导航"
                        android:textColor="#D7E7E4" />

                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_danger"
                        android:backgroundTint="@null"
                        android:text="停止"
                        android:textColor="#FFE9E9" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnSimulate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="模拟导航（当前位置 → 目的地）"
                    android:textColor="#D7E7E4" />

                <Button
                    android:id="@+id/btnTravel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="工具：汽车"
                    android:textColor="#D7E7E4" />

                <Button
                    android:id="@+id/btnStyle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="风格：掌机像素"
                    android:textColor="#D7E7E4" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_zoom"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="4dp">

                    <Button
                        android:id="@+id/btnZoomOut"
                        android:layout_width="52dp"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_secondary"
                        android:backgroundTint="@null"
                        android:text="−"
                        android:textColor="#D7E7E4"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tvZoom"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="1.00×"
                        android:textColor="#F0F6F4"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnZoomIn"
                        android:layout_width="52dp"
                        android:layout_height="44dp"
                        android:background="@drawable/btn_secondary"
                        android:backgroundTint="@null"
                        android:text="+"
                        android:textColor="#D7E7E4"
                        android:textSize="20sp" />
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/ivPreview"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_preview"
                android:contentDescription="320×240 导航画面模拟预览"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnPreviewMode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="预览：SDK 原图"
                    android:textColor="#D7E7E4" />

                <Button
                    android:id="@+id/btnOrientation"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="视角：车头朝上"
                    android:textColor="#D7E7E4" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card"
                android:fontFamily="monospace"
                android:padding="12dp"
                android:textColor="#8FE3A9"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/connectGate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#06090C"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingExtra="0dp"
            android:text="RACE&#10;BRICK"
            android:textColor="#66E0D2"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:letterSpacing="0.25"
            android:text="DEVICE CONNECTION"
            android:textColor="#6D817D"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvGateStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="未连接 RaceBrick"
            android:textColor="#A9C4BE"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btnGateConnect"
            android:layout_width="220dp"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="@drawable/btn_primary"
            android:backgroundTint="@null"
            android:text="连接 RaceBrick"
            android:textColor="#F2FFFB"
            android:textSize="16sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="连接成功后进入导航、媒体与设备设置"
            android:textColor="#6D817D"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/floatingStatus"
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="18dp"
        android:background="@drawable/bg_float_ball"
        android:clickable="true"
        android:contentDescription="RaceBrick 连接状态"
        android:elevation="10dp"
        android:focusable="true"
        android:gravity="center"
        android:text="●"
        android:textColor="#66E0A6"
        android:textSize="22sp"
        android:visibility="gone" />
</FrameLayout>
