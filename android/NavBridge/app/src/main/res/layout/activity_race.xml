<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#06090C">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:paddingTop="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="RACE"
                android:textColor="#F2B95C"
                android:textSize="20sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnRaceNav"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:minHeight="40dp"
                android:text="NAV"
                android:textColor="#D7E7E4" />

            <Button
                android:id="@+id/btnRaceSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/btn_secondary"
                android:backgroundTint="@null"
                android:minHeight="40dp"
                android:text="设置"
                android:textColor="#D7E7E4" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvRaceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="设备未连接"
            android:textColor="#A9C4BE"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="设备地址"
                android:textColor="#F0F6F4"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/etRaceUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input"
                android:hint="http://192.168.4.1"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="#F0F6F4"
                android:textColorHint="#6D817D"
                android:textSize="13sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="ESP 与手机在同一 WiFi 时填 ESP 的局域网 IP；AP 模式默认 192.168.4.1。"
                android:textColor="#6D817D"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRaceDirect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/btn_primary"
                android:backgroundTint="@null"
                android:text="直连 ESP WiFi"
                android:textColor="#F2FFFB" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="点按后系统会连接 RaceBrick-XXXX（密码 racebrick）；直连期间手机可能没有互联网，离开 RACE 会自动断开。"
                android:textColor="#6D817D"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnRaceLoad"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/btn_primary"
                    android:backgroundTint="@null"
                    android:text="连接并刷新"
                    android:textColor="#F2FFFB" />

                <Button
                    android:id="@+id/btnRaceTracks"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="赛道"
                    android:textColor="#D7E7E4" />

                <Button
                    android:id="@+id/btnRaceSessions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_secondary"
                    android:backgroundTint="@null"
                    android:text="场次"
                    android:textColor="#D7E7E4" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/llRaceList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

    </LinearLayout>
</ScrollView>
